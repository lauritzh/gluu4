<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.gluu</groupId>
	<artifactId>oxShibbolethStatic</artifactId>
	<name>OX Shibboleth IDP static resources</name>
	<url>https://www.gluu.org</url>
	<packaging>jar</packaging>
	<version>4.5.13-SNAPSHOT</version>
	<parent>
		<groupId>org.gluu</groupId>
		<artifactId>oxShibboleth</artifactId>
		<version>4.5.13-SNAPSHOT</version>
	</parent>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<shib.extract-directory>${project.build.directory}/classes/shibboleth-identity-provider-${shibboleth.version}</shib.extract-directory>
		<shib.tmp-install-directory>${project.build.directory}/classes/shibboleth-idp-inst</shib.tmp-install-directory>
	</properties>

	<profiles>
		<profile>
			<id>windows-profile</id>
			<activation>
				<os><family>windows</family></os>
			</activation>
			<properties>
				<shib-install-script.name>install.bat</shib-install-script.name>
				<shell-cmd.name>cmd.exe</shell-cmd.name>
			</properties>
		</profile>
		<profile>
			<id>unix-profile</id>
			<activation>
				<os><family>unix</family></os>
			</activation>
			<properties>
				<shib-install-script.name>install.sh</shib-install-script.name>
				<shell-cmd.name>/bin/bash</shell-cmd.name>
			</properties>
		</profile>
	</profiles>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-install-plugin</artifactId>
				<version>2.4</version>
			</plugin>

			<plugin>
				<groupId>com.googlecode.maven-download-plugin</groupId>
				<artifactId>download-maven-plugin</artifactId>
				<version>1.2.1</version>
				<executions>
					<execution>
						<id>download-dist</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>wget</goal>
						</goals>
						<configuration>
							<url>https://shibboleth.net/downloads/identity-provider/latest5/shibboleth-identity-provider-${shibboleth.version}.tar.gz</url>
							<unpack>true</unpack>
							<outputDirectory>${project.build.directory}/classes</outputDirectory>
							<sha256>${shibboleth.dist.sha256}</sha256>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<id>delete-shib-tmp-install-dir</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>clean</goal>
						</goals>
						<configuration>
							<excludeDefaultDirectories>true</excludeDefaultDirectories>
							<filesets>
								<fileset>
									<directory>${shib.tmp-install-directory}</directory>
									<includes>
										<include>**</include>
									</includes>
								</fileset>
							</filesets>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<id>run-idp-install-script</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>${shell-cmd.name}</executable>
							<arguments>
								<argument>${shib.extract-directory}/bin/${shib-install-script.name}</argument>
								<argument>--noPrompt</argument>
								<argument>true</argument>
								<argument>--targetDir</argument>
								<argument>${shib.tmp-install-directory}</argument>
								<argument>--scope</argument>
								<argument>gluu</argument>
								<argument>--entityID</argument>
								<argument>gluu-entity-id</argument>
								<argument>--hostName</argument>
								<argument>gluu-host</argument>
							</arguments>

						</configuration>
					</execution>
				</executions>
			</plugin>

            <plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-patch-plugin</artifactId>
				<version>1.1.1</version>
				<executions>
					<execution>
						<id>gluu-patch</id>
						<phase>process-resources</phase>
						<configuration>
							<targetDirectory>${shib.tmp-install-directory}</targetDirectory>
							<patchDirectory>src/main/patches</patchDirectory>
							<naturalOrderProcessing>true</naturalOrderProcessing>
							<optimizations>false</optimizations>
							<strip>1</strip>
						</configuration>
						<goals>
							<goal>apply</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>1.7</version>
				<executions>
					<execution>
						<id>build-ipd-war</id>
						<phase>process-resources</phase>
						<configuration>
							<target>
								<property name="shib.basedir" value="${project.build.directory}/classes/shibboleth-identity-provider-${shibboleth.version}"/>
								<property name="shib.dest.basedir" value="${project.build.directory}/classes/shibboleth-idp"/>
								<!-- Delete not required webapp folder -->
								<delete dir="${shib.basedir}/webapp"/>
								<!-- Delete .orig files in all folders -->
								<delete dir="${shib.basedir}" includes="**/*.orig"/>
								<!-- Delete destination shibboleth-idp folder -->
								<delete dir="${shib.dest.basedir}"/>
								<!-- Move to shibboleth-idp folder -->
								<move todir="${shib.dest.basedir}">
									<fileset dir="${shib.basedir}"/>
								</move>
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>shibboleth-idp/bin/lib/commons-compress-1.22.jar</exclude>
					</excludes>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy</id>
						<phase>compile</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>org.apache.commons</groupId>
									<artifactId>commons-compress</artifactId>
									<version>1.26.0</version>
									<type>jar</type>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/classes/shibboleth-idp/bin/lib</outputDirectory>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>
</project>
